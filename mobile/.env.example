# URL del backend. En producción apunta al despliegue de Vercel:
#   EXPO_PUBLIC_API_URL=https://beantrust-api.vercel.app
# Contra el backend local en un dispositivo físico usa la IP LAN de tu máquina
# (nunca localhost) y arráncalo con:
#   cd Backend && uvicorn app.main:app --reload --host 0.0.0.0
#
# Ojo: este archivo NO viaja a EAS Build (.env está en .gitignore). El valor que
# acaba embebido en el APK es el de `eas.json` -> build.<perfil>.env.
EXPO_PUBLIC_API_URL=https://beantrust-api.vercel.app
