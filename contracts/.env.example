# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.
# Solo direcciones publicas: la private key NUNCA va aqui (usa `cast wallet import`).

# Cuenta de administracion/despliegue (DEFAULT_ADMIN_ROLE + PAUSER_ROLE).
DEFAULT_ADMIN_ADDRESS=0x032c4f6186c394e2eC3671Fe786047C957Edc532
PAUSER_ADDRESS=0x032c4f6186c394e2eC3671Fe786047C957Edc532

# Wallet caliente del backend (ANCHOR_ROLE). Solo su direccion publica aqui; su
# private key vive en el gestor de secretos del backend (BEAN_WEB3_BACKEND_PRIVATE_KEY).
BACKEND_ANCHOR_ADDRESS=0x0000000000000000000000000000000000000000

# Red de testnet (Base Sepolia).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
