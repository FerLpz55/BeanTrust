# BeanTrust API · Plantilla de configuración de PRODUCCIÓN (Vercel).
#
# NO es un `.env` real: es la lista de variables que viven en el panel de Vercel
# (Production). Los secretos NO van aquí; se cargan por el panel o por stdin con
# `vercel env add` y se representan como `__CONFIGURAR_EN_VERCEL__`.
#
# Nunca commitear valores reales, private keys, API keys ni CRON_SECRET.

# Entorno: production
BEAN_ENVIRONMENT=production
# Deshabilitar /docs, /redoc y /openapi.json en producción.
BEAN_DOCS_ENABLED=false

# --- Anclaje on-chain del Pasaporte (ADR-11, Base Sepolia) ---
# `disabled` -> el QR funciona igual y el worker no firma nada.
# `anchor`   -> activa la firma real (requiere la private key de la wallet caliente).
BEAN_WEB3_MODE=disabled
BEAN_WEB3_CHAIN_ID=84532
BEAN_WEB3_NETWORK_NAME=Base Sepolia
BEAN_WEB3_RPC_URL=https://sepolia.base.org

# Identidad pública del contrato desplegado (Base Sepolia, 2026-09-16).
BEAN_WEB3_CONTRACT_ADDRESS=0x083475298d32724d85E17Dd48f9a9Bd2550035C9
BEAN_WEB3_CONTRACT_CODE_HASH=0x07746f4c5c883f10bc2904690dd2a4969f1945f91e5be55689a5676e01def3d8
BEAN_WEB3_DEPLOYMENT_BLOCK=46926492
BEAN_WEB3_PAUSER_ADDRESS=0x032c4f6186c394e2eC3671Fe786047C957Edc532

BEAN_WEB3_CONFIRMATIONS=2
BEAN_WEB3_EXPLORER_BASE_URL=https://sepolia.basescan.org
BEAN_WEB3_EXPLORER_LABEL=BaseScan

# --- Secretos (solo en Vercel; nunca en el repo) ---
# Wallet caliente del backend (ANCHOR_ROLE): 0x42cC953Bd37cb100074ab9e20AD950D7c0add656
# Se deja vacía hasta la activación real del anclaje.
BEAN_WEB3_BACKEND_PRIVATE_KEY=__CONFIGURAR_EN_VERCEL__
# Secreto del cron (Vercel inyecta `CRON_SECRET`; el backend acepta ambos nombres).
CRON_SECRET=__CONFIGURAR_EN_VERCEL__
