# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# Entorno: development | production
BEAN_ENVIRONMENT=development

# Prefijo de la API (se monta bajo /v1). Nombre/metadata OpenAPI.
BEAN_APP_NAME=BeanTrust API
BEAN_APP_VERSION=0.1.0

# Orígenes permitidos para CORS (paneles web futuros). Separados por coma.
BEAN_CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Repositorio de datos: memory | supabase
#   memory  -> InMemoryLoteRepo (desarrollo y tests, sin infraestructura)
#   supabase-> SupabaseLoteRepo (requiere BEAN_SUPABASE_URL y BEAN_SUPABASE_SERVICE_KEY)
BEAN_REPO_BACKEND=memory

# Proveedor de autenticación: local | supabase
#   local   -> LocalAuthProvider (JWT HS256 con BEAN_JWT_SECRET; solo para desarrollo)
#   supabase-> SupabaseAuthProvider (valida JWKS RS256/ES256 del proyecto real)
BEAN_AUTH_BACKEND=local

# Secreto JWT para el proveedor local (HS256). Mínimo 32 bytes. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BEAN_JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-bytes

# Duración de tokens del proveedor local (segundos). Access ~1h, refresh ~30d.
BEAN_ACCESS_TOKEN_TTL=3600
BEAN_REFRESH_TOKEN_TTL=2592000

# Issuer y audience usados al firmar/validar tokens locales.
BEAN_TOKEN_ISSUER=beantrust-api
BEAN_TOKEN_AUDIENCE=beantrust-api

# Máximo de intentos por IP+endpoint en una ventana (fuerza bruta). En Supabase
# el contador vive en Postgres (app_private.rate_limit_bucket), así que el
# límite es compartido entre instancias.
BEAN_LOGIN_RATE_LIMIT=20
BEAN_RATE_LIMIT_WINDOW_SECONDS=60
# Secreto para firmar (HMAC-SHA256) la clave del rate limit: nunca se guarda la
# IP en claro. Obligatorio en producción. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BEAN_RATE_LIMIT_HMAC_SECRET=

# --- Evidencia fotográfica (bucket privado de Supabase Storage) ---
# Bucket privado donde viven las fotos; solo el backend (service_role) lo toca.
BEAN_EVIDENCE_BUCKET=evidencias-lotes
# Tamaño máximo por archivo (5 MB) y TTL de objetos PENDIENTE sin adjuntar.
BEAN_EVIDENCE_MAX_BYTES=5242880
BEAN_EVIDENCE_TTL_HOURS=24

# --- Supabase (solo necesarias si BEAN_REPO_BACKEND=supabase o BEAN_AUTH_BACKEND=supabase) ---
# Project URL, p.ej. https://xxxx.supabase.co
BEAN_SUPABASE_URL=
# Service role key (solo servidor, NUNCA en el móvil).
BEAN_SUPABASE_SERVICE_KEY=
# Anon/public key (construye el cliente que lleva el JWT del usuario para RLS).
BEAN_SUPABASE_ANON_KEY=

# --- Logging ---
# Nivel de log: DEBUG | INFO | WARNING | ERROR
BEAN_LOG_LEVEL=INFO

# Documentación interactiva (/docs, /redoc, /openapi.json). Deshabilítala en
# producción: BEAN_DOCS_ENABLED=false
BEAN_DOCS_ENABLED=true